# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPEN_MODEL_NAME or GROQ_MODEL: Active Qwen or GPT-OSS open-weights model identifier
# Defaults to active Qwen models (qwen/qwen-2.5-72b-instruct, qwen-2.5-32b) and GPT-OSS (openai/gpt-oss-120b, gpt-oss)
OPEN_MODEL_NAME="qwen/qwen-2.5-72b-instruct"
GROQ_MODEL="qwen-2.5-32b"

# GROQ_API_KEY: Open-source LLM inference key for Qwen / GPT-OSS / LLaMA cascade
GROQ_API_KEY=""

# CLOUDFLARE_ACCOUNT_ID & CLOUDFLARE_API_TOKEN: Cloudflare Workers AI credentials for FLUX / SDXL generation
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# CLOUDFLARE_AI_WORKER_URL: Optional custom Cloudflare Worker AI image endpoint
CLOUDFLARE_AI_WORKER_URL=""

# HUGGINGFACE_API_KEY or HF_TOKEN: Hugging Face Inference API key for FLUX.1-schnell & SDXL
HUGGINGFACE_API_KEY=""
HF_TOKEN=""

# NANOBANANA_API_KEY: Optional dedicated image generation key
NANOBANANA_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
